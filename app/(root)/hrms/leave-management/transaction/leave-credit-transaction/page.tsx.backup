'use client';

import { Heading } from '@/components/layout/heading';
import { Button } from '@/components/ui/button';
import { CollapsibleSection } from '@/components/ui/form/collapsible-section';
import { DataTable } from '@/components/ui/data-table/data-table';
import { InputText } from '@/components/ui/extension/input-text';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Checkbox } from '@/components/ui/checkbox';
import { createLocalCrud, type BaseEntity } from '@/lib/localdb';
import { toast } from 'sonner';
import React, { useEffect, useMemo, useState } from 'react';
import { useForm } from 'react-hook-form';

interface LeaveCreditTransaction extends BaseEntity {
  type: string[];
  department: string[];
  designation: string[];
  leaveYear: string;
  fromDate?: string;
  toDate?: string;
  employee?: string;
  lossOfPay: boolean;
  leaveName: string;
  availed: number;
}

const txDB = createLocalCrud<LeaveCreditTransaction>('leaveCreditTransaction');

const typeOptions = ['VKS', 'Permanent', 'ELearning', 'Robotic', 'Internship', 'Management Admin'];
const departmentOptions = ['Hardware and Network', 'Sales', 'Human Resource', 'Admin', 'LEGAL', 'IT Team'];
const designationOptions = ['Computer Faculty', 'E-learning coordinator', 'Accounts and Finance Executive', 'Client acquisition manager', 'Sr HR Executive', 'Manager HR'];
const employeeOptions = ['Steffi Halian', 'Shruthi NA', 'Bindhushree N', 'Chaithra NS', 'Balu Prabhakar'];
const leaveNames = ['CL', 'SL', 'PL', 'LWP', 'OD'];

export default function LeaveCreditTransactionPage() {
  const [data, setData] = useState<LeaveCreditTransaction[]>([]);
  const [isFormOpen, setIsFormOpen] = useState(false);
  const [editingRow, setEditingRow] = useState<LeaveCreditTransaction | null>(null);

  const { register, handleSubmit, reset, setValue, watch, formState: { errors } } = useForm<LeaveCreditTransaction>({
    defaultValues: {
      type: [],
      department: [],
      designation: [],
      leaveYear: '2025',
      fromDate: '',
      toDate: '',
      employee: '',
      lossOfPay: false,
      leaveName: 'CL',
      availed: 0,
    }
  });

  const loadData = () => {
    try {
      setData(txDB.list());
    } catch (error) {
      toast.error('Failed to load records');
    }
  };

  useEffect(() => { loadData(); }, []);

  const handleAddClick = () => {
    setIsFormOpen(true);
    setEditingRow(null);
    reset({ type: [], department: [], designation: [], leaveYear: '2025', fromDate: '', toDate: '', employee: '', lossOfPay: false, leaveName: 'CL', availed: 0 });
    setTimeout(() => document.getElementById('leave-credit-transaction-form')?.scrollIntoView({ behavior: 'smooth' }), 100);
  };

  const handleFormClose = () => {
    setIsFormOpen(false);
    setEditingRow(null);
    reset({ type: [], department: [], designation: [], leaveYear: '2025', fromDate: '', toDate: '', employee: '', lossOfPay: false, leaveName: 'CL', availed: 0 });
  };

  const onSubmit = (formData: LeaveCreditTransaction) => {
    try {
      if (editingRow) txDB.update(editingRow.id, formData);
      else txDB.create(formData);
      loadData();
      handleFormClose();
      toast.success('Saved successfully');
    } catch (e) {
      toast.error('Save failed');
    }
  };

  const handleEdit = (row: LeaveCreditTransaction) => {
    setEditingRow(row);
    setIsFormOpen(true);
    Object.entries(row).forEach(([k, v]) => setValue(k as any, v as any));
    setTimeout(() => document.getElementById('leave-credit-transaction-form')?.scrollIntoView({ behavior: 'smooth' }), 100);
  };

  const handleDelete = (id: number) => {
    if (!confirm('Delete this record?')) return;
    txDB.remove(id);
    loadData();
  };

  const toggleMulti = (field: 'type' | 'department' | 'designation', value: string, checked: boolean) => {
    const current = watch(field);
    if (checked) setValue(field, [...current, value]);
    else setValue(field, current.filter((v: string) => v !== value));
  };

  const columns = useMemo(() => [
    { accessorKey: 'leaveYear', header: 'Leave Year' },
    { accessorKey: 'employee', header: 'Employee' },
    { accessorKey: 'leaveName', header: 'Leave Name' },
    { accessorKey: 'availed', header: 'Availed' },
    { accessorKey: 'fromDate', header: 'From Date' },
    { accessorKey: 'toDate', header: 'To Date' },
    { accessorKey: 'lossOfPay', header: 'Loss of Pay' },
    {
      id: 'actions', header: 'Actions', cell: ({ row }: { row: any }) => (
        <div className='flex gap-2'>
          <Button variant='outline' size='sm' onClick={() => handleEdit(row.original)}>Edit</Button>
          <Button variant='outline' size='sm' onClick={() => handleDelete(row.original.id)}>Delete</Button>
        </div>
      )
    }
  ], []);

  return (
    <div className='min-h-screen'>
      <div className='container p-1 space-y-4'>
        <div className='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
          <div className='space-y-1'>
            <Heading title='Leave Management' description='Leave Transaction' />
          </div>
          <Button onClick={handleAddClick}>Add Leave Transaction</Button>
        </div>

        <CollapsibleSection title='Leave Transaction List' description='' defaultOpen={true} variant='default' size='lg' className='shadow-lg transition-shadow duration-300 hover:shadow-xl'>
          <DataTable data={data} columns={columns} totalItems={data.length} />
        </CollapsibleSection>

        {isFormOpen && (
          <div id='leave-credit-transaction-form'>
            <CollapsibleSection title={editingRow ? 'Edit Transaction' : 'Add Transaction'} description='' defaultOpen={true} variant='default' size='lg' className='shadow-lg transition-shadow duration-300 hover:shadow-xl'>
              <form onSubmit={handleSubmit(onSubmit)} className='space-y-4'>
                <div className='grid grid-cols-1 lg:grid-cols-4 gap-4'>
                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Type</label>
                    <div className='border rounded-md p-2 max-h-44 overflow-y-auto'>
                      {typeOptions.map((t) => (
                        <label key={t} className='flex items-center gap-2 text-sm'>
                          <Checkbox checked={watch('type').includes(t)} onCheckedChange={(c) => toggleMulti('type', t, c as boolean)} />
                          <span>{t}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Department</label>
                    <div className='border rounded-md p-2 max-h-44 overflow-y-auto'>
                      {departmentOptions.map((t) => (
                        <label key={t} className='flex items-center gap-2 text-sm'>
                          <Checkbox checked={watch('department').includes(t)} onCheckedChange={(c) => toggleMulti('department', t, c as boolean)} />
                          <span>{t}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <div className='space-y-2'>
                    <label className='text-sm font-medium'>Designation</label>
                    <div className='border rounded-md p-2 max-h-44 overflow-y-auto'>
                      {designationOptions.map((t) => (
                        <label key={t} className='flex items-center gap-2 text-sm'>
                          <Checkbox checked={watch('designation').includes(t)} onCheckedChange={(c) => toggleMulti('designation', t, c as boolean)} />
                          <span>{t}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <div className='space-y-4'>
                    <div>
                      <label className='text-sm font-medium'>Leave Year</label>
                      <Select value={watch('leaveYear')} onValueChange={(v) => setValue('leaveYear', v)}>
                        <SelectTrigger><SelectValue placeholder='Year' /></SelectTrigger>
                        <SelectContent>
                          {['2019','2020','2021','2022','2023','2024','2025'].map((y) => <SelectItem key={y} value={y}>{y}</SelectItem>)}
                        </SelectContent>
                      </Select>
                    </div>
                    <div className='grid grid-cols-1 md:grid-cols-2 gap-2'>
                      <div>
                        <label className='text-sm font-medium'>From Date</label>
                        <InputText type='date' {...register('fromDate')} />
                      </div>
                      <div>
                        <label className='text-sm font-medium'>To Date</label>
                        <InputText type='date' {...register('toDate')} />
                      </div>
                    </div>
                    <div>
                      <label className='text-sm font-medium'>Employee</label>
                      <Select value={watch('employee')} onValueChange={(v) => setValue('employee', v)}>
                        <SelectTrigger><SelectValue placeholder='Select employee' /></SelectTrigger>
                        <SelectContent>
                          {employeeOptions.map((e) => <SelectItem key={e} value={e}>{e}</SelectItem>)}
                        </SelectContent>
                      </Select>
                    </div>
                    <div className='flex items-center gap-2'>
                      <Checkbox checked={watch('lossOfPay')} onCheckedChange={(c) => setValue('lossOfPay', c as boolean)} />
                      <span className='text-sm'>Loss of Pay</span>
                    </div>
                  </div>
                </div>

                <div className='grid grid-cols-1 md:grid-cols-3 gap-4'>
                  <div>
                    <label className='text-sm font-medium'>Leave Name</label>
                    <Select value={watch('leaveName')} onValueChange={(v) => setValue('leaveName', v)}>
                      <SelectTrigger><SelectValue placeholder='Leave' /></SelectTrigger>
                      <SelectContent>
                        {leaveNames.map((n) => <SelectItem key={n} value={n}>{n}</SelectItem>)}
                      </SelectContent>
                    </Select>
                  </div>
                  <div>
                    <label className='text-sm font-medium'>Availed</label>
                    <InputText type='number' step='0.5' {...register('availed', { valueAsNumber: true })} />
                  </div>
                </div>

                <div className='flex gap-2'>
                  <Button type='submit'>{editingRow ? 'Update' : 'Save'}</Button>
                  <Button type='button' variant='outline' onClick={handleFormClose}>Cancel</Button>
                </div>
              </form>
            </CollapsibleSection>
          </div>
        )}
      </div>
    </div>
  );
}
