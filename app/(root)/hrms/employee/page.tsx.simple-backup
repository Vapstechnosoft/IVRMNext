"use client";

import { Button } from "@/components/ui/button";
import { GenericDataTable } from "@/components/ui/data-table/generic-data-table";
import { CollapsibleSection } from "@/components/ui/form/collapsible-section";
import {
  FormProvider,
  useFormContext,
} from "@/components/ui/form/form-provider";
import { useEmployeeOnload } from "@/hooks/hrms/useEmployee";
import type { EmployeeListItem } from "@/types/hrms/employee";
import { Plus, X } from "lucide-react";
import AddEmployeeForm from "./_components/add-form";
import { employeeColumns } from "./_components/columns";
import UpdateEmployeeForm from "./_components/update-form";

export default function EmployeePage() {
  const { data: response, isLoading, error } = useEmployeeOnload();

  // Mock employee list data - replace with actual API call
  const employeeList: EmployeeListItem[] = [];

  return (
    <FormProvider<EmployeeListItem>>
      <EmployeePageContent
        employeeList={employeeList}
        isLoading={isLoading}
        error={error}
      />
    </FormProvider>
  );
}

function EmployeePageContent({
  employeeList,
  isLoading,
  error,
}: {
  employeeList: EmployeeListItem[];
  isLoading: boolean;
  error: any;
}) {
  const { openAddForm } = useFormContext<EmployeeListItem>();

  return (
    <div className="min-h-screen">
      <div className="container space-y-4 p-1">
        {/* Header */}
        <div className="flex justify-end">
          <Button
            type="button"
            onClick={openAddForm}
            className="w-fit shadow-md transition-all duration-200 hover:scale-105 hover:shadow-lg"
          >
            <Plus className="h-4 w-4" />
            Add Employee
          </Button>
        </div>

        {/* Data Table Section */}
        <CollapsibleSection
          defaultOpen={true}
          variant="default"
          size="lg"
          className="shadow-lg transition-shadow duration-300 hover:shadow-xl"
        >
          <GenericDataTable<EmployeeListItem>
            data={employeeList}
            columns={employeeColumns}
            isLoading={isLoading}
            error={error}
            columnPinning={{ right: ["actions"] }}
            loadingMessage="Loading employees..."
            noDataTitle="No Employees Found"
            noDataDescription="Get started by adding your first employee"
            errorTitle="Error Loading Employees"
          />
        </CollapsibleSection>

        {/* Forms */}
        <FormSections />
      </div>
    </div>
  );
}

function FormSections() {
  const {
    isAddFormOpen,
    isEditFormOpen,
    selectedRow,
    closeAddForm,
    closeEditForm,
    addFormRef,
    editFormRef,
  } = useFormContext<EmployeeListItem>();

  return (
    <>
      {isAddFormOpen && (
        <div ref={addFormRef}>
          <CollapsibleSection
            title="Add New Employee"
            description="Fill in the details below to create a new employee record"
            defaultOpen={true}
            variant="outline"
            size="md"
            className="slide-in-from-top-4 animate-in shadow-lg duration-300"
          >
            <div className="relative">
              <Button
                type="button"
                onClick={closeAddForm}
                variant="ghost"
                size="sm"
                className="-top-[3.5rem] absolute right-12 w-fit border p-2 shadow-md hover:bg-destructive/10"
              >
                <X className="h-4 w-4 text-destructive" /> Close
              </Button>
              <AddEmployeeForm onSuccess={closeAddForm} />
            </div>
          </CollapsibleSection>
        </div>
      )}

      {isEditFormOpen && selectedRow && (
        <div ref={editFormRef}>
          <CollapsibleSection
            title="Edit Employee"
            defaultOpen={true}
            variant="outline"
            size="md"
            className="slide-in-from-top-4 animate-in border-primary/20 shadow-lg duration-300"
          >
            <div className="relative">
              <Button
                type="button"
                onClick={closeEditForm}
                variant="ghost"
                size="sm"
                className="-top-[3.5rem] absolute right-12 w-fit border p-2 shadow-md hover:bg-destructive/10"
              >
                <X className="h-4 w-4 text-destructive" /> Close
              </Button>
              <UpdateEmployeeForm
                selectedRow={selectedRow}
                onSuccess={closeEditForm}
              />
            </div>
          </CollapsibleSection>
        </div>
      )}
    </>
  );
}
